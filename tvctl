def load_apps():
    """Configured apps, seeding the file from DEFAULT_APPS on first run."""
    try:
        with open(APPS_FILE) as f:
            data = json.load(f)
        apps = data.get("apps") if isinstance(data, dict) else data
        cleaned = []
        for a in apps or []:
            if not isinstance(a, dict) or not a.get("appId"):
                continue
            name = str(a.get("name") or a["appId"])
            cleaned.append({
                "key": str(a.get("key") or re.sub(r"[^a-z0-9]+", "", name.lower()) or a["appId"]),
                "name": name,
                "appId": str(a["appId"]),
                "color": str(a.get("color") or default_color(name)),
                "glyph": str(a.get("glyph", default_glyph(name))),
                "show": a.get("show", True) is not False,
            })
        if cleaned:
            return cleaned
    except FileNotFoundError:
        save_apps(DEFAULT_APPS)
    except Exception:
        pass  # a corrupt or hand-edited file must not break the remote
    return [dict(a) for a in DEFAULT_APPS]


def save_apps(apps):
    os.makedirs(os.path.dirname(APPS_FILE), exist_ok=True)
    tmp = APPS_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"apps": apps}, f, indent=2)
        f.write("\n")
    os.replace(tmp, APPS_FILE)


def app_by_key(key):
    for a in load_apps():
        if a["key"] == key:
            return a
    return None


