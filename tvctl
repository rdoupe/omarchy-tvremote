# ---------------------------------------------------------------- websocket


class WebSocket:
    """Minimal RFC6455 client. Text frames only; that is all the TV sends."""

    def __init__(self, host, port, path, timeout, tls=True):
        sock = socket.create_connection((host, port), timeout=timeout)
        if tls:
            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
            ctx.check_hostname = False      # the TV serves a self-signed cert
            ctx.verify_mode = ssl.CERT_NONE # keyed to its own UUID, not a CA
            self.sock = ctx.wrap_socket(sock, server_hostname=host)
        else:
            self.sock = sock
        self.sock.settimeout(timeout)
        self.send_lock = threading.Lock()
        self.buf = b""

        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall((
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host}:{port}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n\r\n"
        ).encode())

        while b"\r\n\r\n" not in self.buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise ConnectionError("closed during handshake")
            self.buf += chunk
        head, self.buf = self.buf.split(b"\r\n\r\n", 1)
        status = head.split(b"\r\n", 1)[0].decode(errors="replace")
        if "101" not in status:
            raise ConnectionError(f"handshake refused: {status}")
        expect = base64.b64encode(hashlib.sha1(
            (key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
        if expect.lower().encode() not in head.lower():
            raise ConnectionError("bad Sec-WebSocket-Accept")

    def _read(self, n):
        while len(self.buf) < n:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise ConnectionError("connection closed")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def _frame(self, opcode, payload):
        head = bytearray([0x80 | opcode])
        n = len(payload)
        if n < 126:
            head.append(0x80 | n)
        elif n < 65536:
            head.append(0x80 | 126)
            head += struct.pack(">H", n)
        else:
            head.append(0x80 | 127)
            head += struct.pack(">Q", n)
        mask = os.urandom(4)
        head += mask
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        with self.send_lock:
            self.sock.sendall(bytes(head) + masked)

    def send(self, text):
        self._frame(0x1, text.encode())

    def recv(self):
        """Next text message. Answers pings; the TV hangs up otherwise."""
        while True:
            b0, b1 = self._read(2)
            opcode = b0 & 0x0F
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            data = self._read(n) if n else b""
            if opcode == 0x8:
                raise ConnectionError("closed by TV")
            if opcode == 0x9:
                # Unanswered pings get us dropped with reason "notack".
                self._frame(0xA, data)
                continue
            if opcode == 0xA:
                continue
            if opcode in (0x1, 0x2):
                return data.decode(errors="replace")

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def load_token():
    try:
        with open(TOKEN_FILE) as f:
            return f.read().strip()
    except OSError:
        return ""


def save_token(token):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(TOKEN_FILE, "w") as f:
        f.write(token)
    os.chmod(TOKEN_FILE, 0o600)


def channel_endpoints():
    """Where the remote-control channel lives, best first.

    2016 and later: TLS on 8002 with a token. 2014-15 Tizen sets have no
    8002 at all and take a plain ws:// on 8001 with no token -- so a failure
    on the first is a reason to try the second, not to give up.
    """
    return [(WS_PORT, True), (API_PORT, False)]


def connect(timeout=8):
    """Open the remote-control channel. Returns (socket, newly_paired).

    Without a saved token the TV puts an Allow/Deny prompt on screen and says
    nothing until someone answers it with the physical remote, so the first
    connect gets a long read timeout and every later one does not.
    """
    token = load_token()
    path = ("/api/v2/channels/samsung.remote.control?name="
            + base64.b64encode(CLIENT_NAME.encode()).decode())
    if token:
        path += "&token=" + token

    # A first, tokenless connection is slower than a routine one: the TV is
    # deciding whether to prompt, and the handshake itself took 8s when
    # measured -- exactly the default, so first-run pairing raced the
    # deadline and failed with an opaque timeout.
    handshake_timeout = timeout if token else max(timeout, 25)

    ws = None
    last = None
    for port, tls in channel_endpoints():
        try:
            ws = WebSocket(HOST, port, path, handshake_timeout, tls=tls)
            break
        except Exception as exc:
            last = exc
    if ws is None:
        raise last if last else ConnectionError("no remote-control channel")
    ws.sock.settimeout(timeout if token else 45)
    try:
        while True:
            msg = json.loads(ws.recv())
            event = msg.get("event")
            if event == "ms.channel.connect":
                issued = str((msg.get("data") or {}).get("token") or "")
                ws.sock.settimeout(timeout)
                if issued and issued != token:
                    save_token(issued)
                    return ws, True
                return ws, False
            if event in ("ms.channel.unauthorized", "ms.error"):
                raise PermissionError("TV denied the connection: " + json.dumps(msg))
    except Exception:
        ws.close()
        raise


def send_key(ws, name, cmd="Click"):
    """Send one key. `cmd` is Click, or Press/Release for hold-to-repeat.

    Press/Release is what the physical remote does: the TV runs its own
    acceleration for as long as the button is down, so a hold ramps the way
    the real remote ramps instead of at whatever rate a timer here picks. A
    quick Press/Release pair registers as exactly one step, so taps and holds
    share this one path.
    """
    ws.send(json.dumps({
        "method": "ms.remote.control",
        "params": {
            "Cmd": cmd,
            "DataOfCmd": KEYS[name],
            "Option": "false",
            "TypeOfRemote": "SendRemoteKey",
        },
    }))


# --------------------------------------------------------------- TV queries


def local_ipv4():
    """This machine's LAN address, without sending anything.

    A connected UDP socket just picks the route; TEST-NET-1 is used as the
    target so nothing is ever addressed to a real host.
    """
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.connect(("192.0.2.1", 9))
        return sock.getsockname()[0]
    except OSError:
        return ""
    finally:
        sock.close()


def support_map(api_data):
    raw = api_data.get("isSupport") or "{}"
    if isinstance(raw, dict):
        return raw
    try:
        return json.loads(raw)
    except Exception:
        return {}


def identify(ip, timeout=2):
    """Return the device dict if `ip` is a Samsung TV, else None."""
    try:
        with urllib.request.urlopen(
                f"http://{ip}:{API_PORT}/api/v2/", timeout=timeout) as resp:
            data = json.load(resp)
    except Exception:
        return None
    device = data.get("device") or {}
    if "samsung" not in str(device.get("type", "")).lower():
        return None
    name = str(device.get("name") or "TV")
    name = name.replace("&quot;", '"').replace("&amp;", "&").replace("&apos;", "'")
    return {
        "ip": ip,
        "name": name,
        "model": device.get("modelName", ""),
        "mac": re.sub(r"[^0-9A-Fa-f]", "", device.get("wifiMac") or ""),
        "tokenAuth": str(device.get("TokenAuthSupport", "")).lower() == "true",
        # isSupport is JSON *inside* a JSON string, so it needs a second parse.
        "remote": str((support_map(data)).get("remote_available", "")).lower() == "true",
        "firmware": device.get("firmwareVersion", ""),
    }


def discover(timeout=0.6, workers=64):
    """Find Samsung TVs by asking every address on this /24 for /api/v2/.

    Deliberately a TCP sweep rather than SSDP. SSDP is the documented way and
    it is one packet instead of 254, but its replies are unicast UDP from the
    TV to an ephemeral port, which conntrack does not see as ESTABLISHED --
    so a default-deny firewall silently eats them and discovery "just doesn't
    work" with nothing to see. The sweep is plain outbound TCP that any
    firewall already allows, and it costs about three seconds.
    """
    me = local_ipv4()
    if not me:
        return []
    base = me.rsplit(".", 1)[0]
    candidates = [f"{base}.{i}" for i in range(1, 255) if f"{base}.{i}" != me]

    open_hosts = []
    lock = threading.Lock()

    def probe(ip):
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        try:
            if sock.connect_ex((ip, API_PORT)) == 0:
                with lock:
                    open_hosts.append(ip)
        except OSError:
            pass
        finally:
            sock.close()

    queue = list(candidates)
    qlock = threading.Lock()

    def worker():
        while True:
            with qlock:
                if not queue:
                    return
                ip = queue.pop()
            probe(ip)

    threads = [threading.Thread(target=worker, daemon=True)
               for _ in range(min(workers, len(candidates)))]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout * 8 + 5)

    found = []
    for ip in sorted(open_hosts):
        info = identify(ip)
        if info:
            found.append(info)
    return found


def load_host():
    try:
        with open(HOST_FILE) as f:
            return f.read().strip()
