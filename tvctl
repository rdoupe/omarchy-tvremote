# Everything on the other end of these sockets is untrusted: the TV is a
# closed-source appliance, and discovery talks to whatever answers on the LAN.
# Nothing it says is allowed to make this process allocate without bound.
MAX_FRAME = 1 << 20        # 1 MiB; real frames here are a few hundred bytes
MAX_HTTP = 1 << 20         # 1 MiB; the largest real reply is ~1.5 KB
MAX_STATE = 64 << 10       # 64 KiB; state files are one line
MAX_CONFIG = 1 << 20       # the app list is ~5 KB; MAX_APPS entries fit easily
