        f.write(ip)


# What the last discovery turned up. Kept so a caller that finds several TVs
# can offer the choice instead of guessing.
DISCOVERED = []


def choose_host(ip):
    """Commit to one TV: remember it, and its MAC while the set is reachable."""
    global HOST
    info = identify(ip, timeout=3)
    HOST = ip
    save_host(ip)
    if info and info["mac"]:
        save_mac(info["mac"])
    return info


def ensure_host(allow_discovery=True):
    """Settle on a TV address: explicit setting, then last known, then search.

    One TV on the network is chosen automatically. Several is not something
    to guess at -- HOST is left empty and DISCOVERED holds the candidates for
    the caller to present.
    """
    global HOST, DISCOVERED
    if HOST:
        return HOST
    cached = load_host()
    if cached and identify(cached, timeout=2):
        HOST = cached
        return HOST
    if not allow_discovery:
        HOST = cached
        return HOST
    DISCOVERED = discover()
    if len(DISCOVERED) == 1:
        choose_host(DISCOVERED[0]["ip"])
    elif not DISCOVERED and cached:
        HOST = cached          # off right now, but it is where it last was
    return HOST


def load_mac():
    mac = os.environ.get("TV_MAC", "")
    if not mac:
        try:
            with open(MAC_FILE) as f:
                mac = f.read().strip()
        except OSError:
            return ""
    mac = re.sub(r"[^0-9A-Fa-f]", "", mac)
    return mac if len(mac) == 12 else ""


def save_mac(mac):
    clean = re.sub(r"[^0-9A-Fa-f]", "", mac or "")
    if len(clean) != 12 or clean == load_mac():
        return
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(MAC_FILE, "w") as f:
        f.write(clean)


