def valid_app_id(app_id):
    return isinstance(app_id, str) and bool(APP_ID.match(app_id))


def plain(text, limit=64):
    """Device-supplied text made safe to show: no control characters, bounded."""
    return re.sub(r"[\x00-\x1f\x7f-\x9f  ‪-‮⁦-⁩]",
                  "", str(text))[:limit]


def read_small(path, follow=False, limit=MAX_STATE):
    """A whole small file, or OSError.

    Regular files only, and never more than MAX_STATE: a FIFO or device node
    planted at one of these paths would otherwise block or flood the reader.
    O_NONBLOCK keeps the open itself from hanging on a FIFO. State files are
    never symlinks, so those are refused; the app config may legitimately be
    one (dotfile managers link ~/.config), so it follows them.
    """
    flags = os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC
    if not follow:
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(f"not a regular file: {path}")
        data = bytearray()
        while len(data) <= limit:
            chunk = os.read(fd, limit + 1 - len(data))
            if not chunk:
                break
            data += chunk
    finally:
        os.close(fd)
    if len(data) > limit:
        raise OSError(f"too large: {path}")
    return bytes(data).decode("utf-8", "replace")


def write_private(path, text):
    """Replace `path` atomically with a fresh 0600 file.

    The data goes to a new, uniquely named temp file -- mkstemp opens it
    O_CREAT|O_EXCL with mode 0600, so nothing pre-placed there (a symlink, a
    file someone else can read) is ever written through -- and is then
    renamed over the target. rename() replaces a symlink rather than
    following it, so a link at `path` cannot redirect the write either.
    """
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory,
                               prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def load_apps():
    """Configured apps, seeding the file from DEFAULT_APPS on first run."""
    try:
        data = json.loads(read_small(APPS_FILE, follow=True, limit=MAX_CONFIG))
        apps = data.get("apps") if isinstance(data, dict) else data
        cleaned = []
        for a in (apps if isinstance(apps, list) else [])[:MAX_APPS]:
            # The id is checked here too, not only when a scan finds it: it
            # ends up in a URL path, and this file can be edited by hand.
            if not isinstance(a, dict) or not valid_app_id(a.get("appId")):
                continue
            name = plain(a.get("name") or a["appId"])
            # Sanitised whether supplied or generated. These keys are sent
            # to the helper over a line-oriented stdin protocol, so an
            # embedded newline in a hand-edited config would split one
            # command into two.
            raw_key = str(a.get("key") or name.lower())
            key = re.sub(r"[^a-z0-9]+", "", raw_key) or re.sub(
                r"[^a-z0-9]+", "", str(a["appId"]))
            cleaned.append({
                "key": key,
                "name": name,
                "appId": str(a["appId"]),
                # Blank marks and the grey fallback mean "nothing known when
                # this was saved", not a choice, so the tables fill them in.
                "color": str(a.get("color") if a.get("color") not in
                             (None, "", FALLBACK_COLOR) else default_color(name)),
                "glyph": str(a.get("glyph") or default_glyph(name)),
                "show": a.get("show", True) is not False,
            })
        if cleaned:
            return cleaned
    except FileNotFoundError:
        save_apps(DEFAULT_APPS)
    except Exception:
        pass  # a corrupt or hand-edited file must not break the remote
    return [dict(a) for a in DEFAULT_APPS]


def save_apps(apps):
    write_private(APPS_FILE, json.dumps({"apps": apps}, indent=2) + "\n")


def app_by_key(key):
    for a in load_apps():
        if a["key"] == key:
            return a
    return None


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


# ---------------------------------------------------------------- websocket


class WebSocket:
    """Minimal RFC6455 client. Text frames only; that is all the TV sends."""

    def __init__(self, host, port, path, timeout, tls=True, deadline=None):
        # `deadline` (a time.monotonic() value) bounds the whole exchange, not
        # just each recv: a peer trickling one byte per timeout would
        # otherwise hold the handshake open indefinitely. connect() clears
        # it once the channel is up; the long-lived reader runs without one.
        self.deadline = deadline
        sock = socket.create_connection((host, port), timeout=timeout)
        if tls:
            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
            ctx.check_hostname = False      # the TV serves a self-signed cert
            ctx.verify_mode = ssl.CERT_NONE # keyed to its own UUID, not a CA
            self.sock = ctx.wrap_socket(sock, server_hostname=host)
        else:
            self.sock = sock
        self.sock.settimeout(timeout)
        self.send_lock = threading.Lock()
        # bytearray: appending to bytes copies the whole buffer each time, so
        # a peer feeding 1 MiB a byte at a time cost quadratic CPU.
        self.buf = bytearray()

        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall((
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host}:{port}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n\r\n"
        ).encode())

        end = -1
        while end < 0:
            # Only the new bytes (plus 3 of overlap) can complete the
            # terminator, so only they are searched.
            start = max(0, len(self.buf) - 3)
            self._fill()
            if len(self.buf) > MAX_FRAME:
                raise ConnectionError("handshake headers too large")
            end = self.buf.find(b"\r\n\r\n", start)
        head = bytes(self.buf[:end])
        del self.buf[:end + 4]
        status = head.split(b"\r\n", 1)[0].decode(errors="replace")
        if "101" not in status:
            raise ConnectionError(f"handshake refused: {status}")
        expect = base64.b64encode(hashlib.sha1(
            (key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
        if expect.lower().encode() not in head.lower():
            raise ConnectionError("bad Sec-WebSocket-Accept")

    def _fill(self):
        if self.deadline is not None:
            left = self.deadline - time.monotonic()
            if left <= 0:
                raise TimeoutError("TV took too long to answer")
            self.sock.settimeout(min(left, self.sock.gettimeout() or left))
        chunk = self.sock.recv(4096)
        if not chunk:
            raise ConnectionError("connection closed")
        self.buf += chunk

    def _read(self, n):
        while len(self.buf) < n:
            self._fill()
        out = bytes(self.buf[:n])
        del self.buf[:n]
        return out

    def _frame(self, opcode, payload):
        head = bytearray([0x80 | opcode])
        n = len(payload)
        if n < 126:
            head.append(0x80 | n)
        elif n < 65536:
            head.append(0x80 | 126)
            head += struct.pack(">H", n)
        else:
            head.append(0x80 | 127)
            head += struct.pack(">Q", n)
        mask = os.urandom(4)
        head += mask
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        with self.send_lock:
            self.sock.sendall(bytes(head) + masked)

    def send(self, text):
        self._frame(0x1, text.encode())

    def recv(self):
        """Next text message. Answers pings; the TV hangs up otherwise."""
        while True:
            b0, b1 = self._read(2)
            opcode = b0 & 0x0F
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            # A 64-bit length field is attacker-controlled: without this a
            # single malformed frame header would have us try to buffer it.
            if n > MAX_FRAME:
                raise ConnectionError(f"frame too large ({n} bytes)")
            data = self._read(n) if n else b""
            if opcode == 0x8:
                raise ConnectionError("closed by TV")
            if opcode == 0x9:
                # Unanswered pings get us dropped with reason "notack".
                self._frame(0xA, data)
                continue
            if opcode == 0xA:
                continue
            if opcode in (0x1, 0x2):
                return data.decode(errors="replace")

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def load_token():
    try:
        token = read_small(TOKEN_FILE).strip()
    except OSError:
        return ""
    return token if TOKEN.match(token) else ""


def save_token(token):
    # write_private creates it 0600 from the start: writing first and
    # chmod'ing afterwards leaves the token briefly readable.
    write_private(TOKEN_FILE, token)


def channel_endpoints():
    """Where the remote-control channel lives, best first.

    2016 and later: TLS on 8002 with a token. 2014-15 Tizen sets have no
    8002 at all and take a plain ws:// on 8001 with no token -- so a failure
    on the first is a reason to try the second, not to give up.
    """
    return [(WS_PORT, True), (API_PORT, False)]


def connect(timeout=8, _after_pairing=False, on_prompt=None):
    """Open the remote-control channel. Returns (socket, newly_paired).

    Without a saved token the TV puts an Allow/Deny prompt on screen and says
    nothing until someone answers it with the physical remote, so the first
    connect gets a long read timeout and every later one does not.

    `_after_pairing` marks the one reconnect this may make on its own, and
    caps it at one: the TV hands over a token and then drops the socket, so
    the useful connection is the *next* one.

    `on_prompt` is called once a tokenless request has been accepted by the
    TV -- the moment its Allow/Deny prompt goes up -- so a caller can tell
    "asking" apart from "the question is on screen".
    """
    token = load_token()
    path = ("/api/v2/channels/samsung.remote.control?name="
            + base64.b64encode(CLIENT_NAME.encode()).decode())
    if token:
        path += "&token=" + token

    # A first, tokenless connection is slower than a routine one: the TV is
    # deciding whether to prompt, and the handshake itself took 8s when
    # measured -- exactly the default, so first-run pairing raced the
    # deadline and failed with an opaque timeout.
    handshake_timeout = timeout if token else max(timeout, 25)
    # Per-recv timeouts alone never end a connect whose peer keeps sending
    # something other than an answer, and this runs on the stdin loop. The
    # total allowance covers a human walking over to answer the prompt.
    budget = handshake_timeout + (timeout if token else 45)

    ws = None
    last = None
    for port, tls in channel_endpoints():
        try:
            ws = WebSocket(HOST, port, path, handshake_timeout, tls=tls,
                           deadline=time.monotonic() + budget)
            break
        except Exception as exc:
            last = exc
    if ws is None:
        raise last if last else ConnectionError("no remote-control channel")
    ws.sock.settimeout(timeout if token else 45)
    if not token and on_prompt is not None:
        on_prompt()
    try:
        while True:
            msg = json.loads(ws.recv())
            if not isinstance(msg, dict):
                continue
            event = msg.get("event")
            if event == "ms.channel.connect":
                data = msg.get("data")
                issued = str((data if isinstance(data, dict) else {})
                             .get("token") or "")
                if issued and not TOKEN.match(issued):
                    raise ConnectionError("TV sent a malformed token")
                ws.deadline = None
                ws.sock.settimeout(timeout)
                if issued and issued != token:
                    save_token(issued)
                    # The tokenless connection exists only to raise the
                    # prompt: moments after issuing a token the TV hangs it
                    # up. Waiting for that close to arrive left the panel
                    # reading "connecting..." until some later keypress
                    # happened to notice, so spend the reconnect now, while
                    # the caller is still inside connect() and one clean
                    # result can be reported for the whole pairing.
                    if _after_pairing:
                        return ws, True
                    ws.close()
                    return connect(timeout, _after_pairing=True)[0], True
                return ws, False
            if event in ("ms.channel.unauthorized", "ms.error"):
                raise PermissionError("TV denied the connection: " + json.dumps(msg))
    except Exception:
        ws.close()
        raise


def send_key(ws, name, cmd="Click"):
    """Send one key. `cmd` is Click, or Press/Release for hold-to-repeat.

    Press/Release is what the physical remote does: the TV runs its own
    acceleration for as long as the button is down, so a hold ramps the way
    the real remote ramps instead of at whatever rate a timer here picks. A
    quick Press/Release pair registers as exactly one step, so taps and holds
    share this one path.
    """
    ws.send(json.dumps({
        "method": "ms.remote.control",
        "params": {
            "Cmd": cmd,
            "DataOfCmd": KEYS[name],
            "Option": "false",
            "TypeOfRemote": "SendRemoteKey",
        },
    }))


# --------------------------------------------------------------- TV queries


def valid_ipv4(text):
    parts = str(text).split(".")
    return (len(parts) == 4 and all(p.isdigit() and len(p) <= 3
            and 0 <= int(p) <= 255 for p in parts))


def local_ipv4():
    """This machine's LAN address, without sending anything.

    A connected UDP socket just picks the route; TEST-NET-1 is used as the
    target so nothing is ever addressed to a real host.
    """
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.connect(("192.0.2.1", 9))
        return sock.getsockname()[0]
    except OSError:
        return ""
    finally:
        sock.close()


MAX_HEAD = 64 << 10        # status line + headers; real ones are ~300 bytes


def http_request(method, host, port, path, body=b"", headers=None, timeout=3):
    """One HTTP/1.1 request on a fresh socket. Returns (status, body).

    Hand-rolled rather than urllib because every byte of the reply comes
    from the LAN, and urllib's limits are per-recv only: a server trickling
    its status line, headers or chunk-size lines one byte at a time held a
    request open indefinitely, and its redirect handler drained 3xx bodies
    with no size cap at all. Here one deadline covers the whole exchange,
    every part of the reply is capped, redirects are never followed (a 3xx
    is just a status), and no proxy is ever consulted.
    """
    deadline = time.monotonic() + timeout * 2
    lines = [f"{method} {path} HTTP/1.1", f"Host: {host}:{port}",
             "Connection: close", "Accept-Encoding: identity",
             f"Content-Length: {len(body)}"]
    lines += [f"{k}: {v}" for k, v in (headers or {}).items()]
    buf = bytearray()
    with socket.create_connection((host, port), timeout=timeout) as sock:
        sock.sendall(("\r\n".join(lines) + "\r\n\r\n").encode() + body)

        def fill():
            left = deadline - time.monotonic()
            if left <= 0:
                raise TimeoutError("reply too slow")
            sock.settimeout(min(left, timeout))
            chunk = sock.recv(65536)
            buf.extend(chunk)
            return bool(chunk)

        def until(marker, cap):
            """Index of `marker` in buf, reading as needed, within `cap`."""
            start = 0
            while True:
                at = buf.find(marker, start)
                if at >= 0:
                    return at
                if len(buf) > cap:
                    raise ValueError("reply too large")
                start = max(0, len(buf) - len(marker) + 1)
                if not fill():
                    raise ConnectionError("reply cut short")

        end = until(b"\r\n\r\n", MAX_HEAD)
        head = bytes(buf[:end]).decode("latin-1").split("\r\n")
        del buf[:end + 4]
        status = head[0].split(" ", 2)
        if len(status) < 2 or not status[0].startswith("HTTP/1.") \
                or not (status[1].isdigit() and len(status[1]) == 3):
            raise ConnectionError("not an HTTP reply")
        code = int(status[1])
        if not 200 <= code < 300:
            # Redirects and errors carry nothing any caller uses, so their
            # bodies are never read -- a 3xx is a status, not an instruction.
            return code, b""
        fields = {}
        for line in head[1:]:
            name, sep, value = line.partition(":")
            if not sep:
                continue
            name, value = name.strip().lower(), value.strip()
            # Two lengths that disagree make the body boundary ambiguous.
            if name in fields and fields[name] != value:
                raise ConnectionError(f"conflicting {name} headers")
            fields[name] = value

        coding = fields.get("transfer-encoding", "").lower()
        if coding.rsplit(",", 1)[-1].strip() == "chunked":
            out = bytearray()
            while True:
                eol = until(b"\r\n", 64)
                size = bytes(buf[:eol]).split(b";", 1)[0].strip()
                del buf[:eol + 2]
                if not size or len(size) > 8 or not all(
                        c in b"0123456789abcdefABCDEF" for c in size):
                    raise ConnectionError("bad chunk size")
                n = int(size, 16)
                if n == 0:
                    break                     # trailers, if any, are ignored
                if len(out) + n > MAX_HTTP:
                    raise ValueError("reply too large")
                while len(buf) < n + 2:
                    if not fill():
                        raise ConnectionError("reply cut short")
                if buf[n:n + 2] != b"\r\n":
                    raise ConnectionError("bad chunk framing")
                out += buf[:n]
                del buf[:n + 2]
            data = bytes(out)
        elif "content-length" in fields:
            length = fields["content-length"]
            if not (length.isascii() and length.isdigit()):
                raise ConnectionError("bad Content-Length")
            if int(length) > MAX_HTTP:
                raise ValueError("reply too large")
            while len(buf) < int(length):
                if not fill():
                    raise ConnectionError("reply cut short")
            data = bytes(buf[:int(length)])
        else:
            while fill():
                if len(buf) > MAX_HTTP:
                    raise ValueError("reply too large")
            data = bytes(buf)
    return code, data


def fetch_json(host, port, path, timeout=3):
    """GET and parse JSON; anything but a 200 is an error."""
    status, raw = http_request("GET", host, port, path, timeout=timeout)
    if status != 200:
        raise ConnectionError(f"HTTP {status}")
    return json.loads(raw.decode("utf-8", "replace"))


def support_map(api_data):
    raw = api_data.get("isSupport") or "{}"
    if isinstance(raw, dict):
        return raw
    try:
        parsed = json.loads(raw)
    except Exception:
        return {}
    return parsed if isinstance(parsed, dict) else {}


def identify(ip, timeout=2):
    """Return the device dict if `ip` is a Samsung TV, else None."""
    # Everything about the reply is parsed inside the guard: any host on the
    # LAN can answer this, and valid JSON that simply is not an object ("ok",
    # [], 42) would otherwise raise past the caller. That path is reached
    # from the TV picker on the daemon's main loop, where it would kill the
    # process outright.
    try:
        data = fetch_json(ip, API_PORT, "/api/v2/", timeout)
        if not isinstance(data, dict):
            return None
        device = data.get("device")
        if not isinstance(device, dict):
            return None
        if "samsung" not in str(device.get("type", "")).lower():
            return None
        return {
            "ip": ip,
            "name": device_name(device),
            "model": plain(device.get("modelName") or ""),
            "mac": clean_mac(device.get("wifiMac")),
            "tokenAuth": str(device.get("TokenAuthSupport", "")).lower() == "true",
            # isSupport is JSON *inside* a JSON string: a second parse.
            "remote": str(support_map(data).get("remote_available", "")).lower() == "true",
            "firmware": plain(device.get("firmwareVersion") or ""),
        }
    except Exception:
        return None


def device_name(device):
    # The TV HTML-escapes its own name, so '55" QLED' arrives as 55&quot; QLED.
    name = str(device.get("name") or "TV")
    name = name.replace("&quot;", '"').replace("&amp;", "&").replace("&apos;", "'")
    return plain(name) or "TV"


def clean_mac(mac):
    """12 hex digits, or "" -- whatever type the reply put there."""
    mac = re.sub(r"[^0-9A-Fa-f]", "", mac if isinstance(mac, str) else "")
    return mac if len(mac) == 12 else ""


def discover(timeout=0.6, workers=64):
    """Find Samsung TVs by asking every address on this /24 for /api/v2/.

    Deliberately a TCP sweep rather than SSDP. SSDP is the documented way and
    it is one packet instead of 254, but its replies are unicast UDP from the
    TV to an ephemeral port, which conntrack does not see as ESTABLISHED --
    so a default-deny firewall silently eats them and discovery "just doesn't
    work" with nothing to see. The sweep is plain outbound TCP that any
    firewall already allows, and it costs about three seconds.
    """
    me = local_ipv4()
    if not me:
        return []
    base = me.rsplit(".", 1)[0]
    candidates = [f"{base}.{i}" for i in range(1, 255) if f"{base}.{i}" != me]

    open_hosts = []
    lock = threading.Lock()

    def probe(ip):
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        try:
            if sock.connect_ex((ip, API_PORT)) == 0:
                with lock:
                    open_hosts.append(ip)
        except OSError:
            pass
        finally:
            sock.close()

    queue = list(candidates)
    qlock = threading.Lock()

    def worker():
        while True:
            with qlock:
                if not queue:
                    return
                ip = queue.pop()
            probe(ip)

    threads = [threading.Thread(target=worker, daemon=True)
               for _ in range(min(workers, len(candidates)))]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout * 8 + 5)

    # Identified in parallel and under one deadline, like the sweep: a
    # single host answering for every free address would otherwise make
    # this 253 sequential identify() calls while the panel sits blank.
    found = []
    with lock:
        pending = sorted(open_hosts)
    deadline = time.monotonic() + 15

    def identify_worker():
        while time.monotonic() < deadline:
            with qlock:
                if not pending:
                    return
                ip = pending.pop()
            info = identify(ip)
            if info:
                with lock:
                    found.append(info)

    threads = [threading.Thread(target=identify_worker, daemon=True)
               for _ in range(min(16, len(pending)))]
    for t in threads:
        t.start()
    for t in threads:
        t.join(max(0, deadline - time.monotonic()))
    with lock:
        return sorted(found, key=lambda d: tuple(int(p) for p in d["ip"].split(".")))


def load_host():
    try:
        host = read_small(HOST_FILE).strip()
    except OSError:
        return ""
    return host if valid_ipv4(host) else ""


def save_host(ip):
    if not valid_ipv4(ip) or ip == load_host():
        return
    write_private(HOST_FILE, ip)


# What the last discovery turned up. Kept so a caller that finds several TVs
# can offer the choice instead of guessing.
DISCOVERED = []


def choose_host(ip):
    """Commit to one TV: remember it, and its MAC while the set is reachable."""
    global HOST
    info = identify(ip, timeout=3)
    HOST = ip
    save_host(ip)
    if info and info["mac"]:
        save_mac(info["mac"])
    return info


def ensure_host(allow_discovery=True):
    """Settle on a TV address: explicit setting, then last known, then search.

    One TV on the network is chosen automatically. Several is not something
    to guess at -- HOST is left empty and DISCOVERED holds the candidates for
    the caller to present.
    """
    global HOST, DISCOVERED
    if HOST:
        return HOST
    cached = load_host()
    if cached and identify(cached, timeout=2):
        HOST = cached
        return HOST
    if not allow_discovery:
        HOST = cached
        return HOST
    DISCOVERED = discover()
    if len(DISCOVERED) == 1:
        choose_host(DISCOVERED[0]["ip"])
    elif not DISCOVERED and cached:
        HOST = cached          # off right now, but it is where it last was
    return HOST


def load_mac():
    mac = os.environ.get("TV_MAC", "")
    if not mac:
        try:
            mac = read_small(MAC_FILE).strip()
        except OSError:
            return ""
    return clean_mac(mac)


def save_mac(mac):
    clean = clean_mac(mac)
    if not clean or clean == load_mac():
        return
    write_private(MAC_FILE, clean)


def load_last_app():
    try:
        return re.sub(r"[^a-z0-9]", "", read_small(LAST_APP_FILE).strip().lower())[:40]
    except OSError:
        return ""


def save_last_app(key):
    if not key or key == load_last_app():
        return
    write_private(LAST_APP_FILE, key)


def wake(mac=None):
    """Wake-on-LAN magic packet: 6 x 0xFF then the MAC repeated 16 times.

    The remote-control socket is useless here -- a TV that is off answers
    nothing on any port -- so powering on has to come from the NIC, which
    stays listening. Sent to both the global and the subnet broadcast
    address, on the two ports WoL is conventionally received on, because
    which combination a given network passes varies.
    """
    mac = re.sub(r"[^0-9A-Fa-f]", "", mac or load_mac())
    if len(mac) != 12:
        raise ValueError("no MAC known for the TV; run `tvctl state` while it is on")
    packet = b"\xff" * 6 + bytes.fromhex(mac) * 16

    targets = ["255.255.255.255"]
    parts = HOST.split(".")
    if len(parts) == 4 and all(p.isdigit() for p in parts):
        targets.append(".".join(parts[:3] + ["255"]))

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    sent = 0
    try:
        for addr in targets:
            for port in (9, 7):
                for _ in range(3):        # cheap, and a lost packet is silent
                    try:
                        sock.sendto(packet, (addr, port))
                        sent += 1
                    except OSError:
                        pass
    finally:
        sock.close()
    return sent


def power_on(send_power, on_progress=None, timeout=80):
    """Bring the TV from off to a picture. Two stages, both required.

    Measured on this set: the magic packet alone wakes only the network
    stack. The API starts answering after ~40s and then reports
    PowerState=standby indefinitely -- it sat there for well over a minute
    and never promoted itself. The screen only comes on once a power key is
    sent over the websocket that the first stage made reachable.

    `send_power` is a callable that delivers KEY_POWER, so the caller can
    supply its own already-connected socket.
    """
    wake()
    if on_progress:
        on_progress("packet")

    device = None
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(2)
        device = read_device(timeout=2)
        if device:
            break
    if not device:
        return False
    if on_progress:
        on_progress("network")

    if str(device.get("power", "")).lower() != "standby":
        return True

    for _ in range(3):
        try:
            if send_power():
                break
        except Exception:
            pass
        time.sleep(1)
    if on_progress:
        on_progress("power")

    for _ in range(12):
        time.sleep(2)
        device = read_device(timeout=2)
        if device and str(device.get("power", "")).lower() == "on":
            return True
    return False


def soap(action, body, timeout=3):
    service = "urn:schemas-upnp-org:service:RenderingControl:1"
    envelope = (
        '<?xml version="1.0"?>'
        '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"'
        ' s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body>'
        f'<u:{action} xmlns:u="{service}"><InstanceID>0</InstanceID>'
        f'<Channel>Master</Channel>{body}</u:{action}>'
        "</s:Body></s:Envelope>"
    )
    status, reply = http_request(
        "POST", HOST, UPNP_PORT, "/upnp/control/RenderingControl1",
        envelope.encode(), {"Content-Type": 'text/xml; charset="utf-8"',
                            "SOAPACTION": f'"{service}#{action}"'}, timeout)
    if status != 200:
        raise ConnectionError(f"HTTP {status}")
    return reply.decode(errors="replace")


def read_volume(timeout=3):
    """(volume, muted); either is None when the TV does not answer."""
    volume = muted = None
    try:
        m = re.search(r"<CurrentVolume>(\d+)", soap("GetVolume", "", timeout))
        if m:
            volume = int(m.group(1))
    except Exception:
        pass
    try:
        m = re.search(r"<CurrentMute>(\d+)", soap("GetMute", "", timeout))
        if m:
            muted = m.group(1) == "1"
    except Exception:
        pass
    return volume, muted


def read_device(timeout=3):
    # Parsed entirely inside the guard, like identify(): a reply of the
    # wrong shape must read as "not a TV", never raise into a poll thread.
    try:
        data = fetch_json(HOST, API_PORT, "/api/v2/", timeout)
        device = data.get("device") if isinstance(data, dict) else None
        if not isinstance(device, dict):
            device = {}
        info = {"name": device_name(device),
                "model": plain(device.get("modelName") or ""),
                "power": plain(device.get("PowerState") or "unknown", 16)}
        mac = clean_mac(device.get("wifiMac")) or clean_mac(device.get("mac"))
    except Exception:
        return None
    # Learn the MAC while we can, so wake-on-LAN works once it is off.
    try:
        save_mac(mac)
    except OSError:
        pass
    return info


# Set while a key is held down. This TV's little HTTP server is easily
# saturated, and a burst of app-status probes during a hold visibly starves
# the TV's own key-repeat -- a 1.3s hold that should ramp eight steps moves
# one. Nothing polls it while a button is down.
HELD_KEYS = set()


def app_status(app_id, timeout=3):
    if not valid_app_id(app_id):
        return None
    try:
        info = fetch_json(
            HOST, API_PORT, f"/api/v2/applications/{app_id}", timeout)
    except Exception:
        return None
    return info if isinstance(info, dict) else None


def launch_app(key):
    """Bring a streaming app to the foreground.

    This is a REST POST rather than a remote key: the remote channel can only
    click buttons, so reaching an app through it would mean guessing at the
    home screen's layout.
    """
    app = app_by_key(key)
    if app is None:
        raise KeyError(key)
    if not valid_app_id(app["appId"]):
        raise ValueError(f"bad app id for {key}")
    status, _ = http_request(
        "POST", HOST, API_PORT, f"/api/v2/applications/{app['appId']}", timeout=8)
    if status >= 300:
        raise ConnectionError(f"HTTP {status}")
    return status == 200


def foreground_app(timeout=3):
    """Which of our apps is on screen, if any.

    An app that has been used stays `running` in the background long after it
    left the screen, so `visible` is the only field that answers this.
    """
    if HELD_KEYS:
        return ""
    # Only the pinned apps. Probing every discovered app doubles the request
    # burst for a highlight nobody can see on a hidden tile.
    apps = [a for a in load_apps() if a.get("show", True)]
    found = [None]
    lock = threading.Lock()

    def probe(app):
        info = app_status(app["appId"], timeout)
        if isinstance(info, dict) and info.get("visible"):
            with lock:
                found[0] = app["key"]

    # In parallel: this TV's HTTP server answers one request at a time, and a
    # serial sweep of nine apps was slow enough to delay the volume read that
    # runs right after a volume key -- the panel would show a stale number.
    threads = [threading.Thread(target=probe, args=(a,), daemon=True) for a in apps]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout * 2 + 1)        # a probe's own deadline is 2x timeout
    if found[0]:
        save_last_app(found[0])
    return found[0] or ""


def short_name(name):
    """App store names run long ("Tubi - Free Movies & TV"); tiles do not."""
    name = re.split(r"\s*[-–:|]\s+", name, maxsplit=1)[0].strip()
    if len(name) <= 18:
        return name
    # Whole words where possible: "MagellanTV Documentaries" reads better as
    # "MagellanTV" than as "MagellanTV Docume…".
    words = name.split()
    kept = words[0]
    for word in words[1:]:
        if len(kept) + 1 + len(word) > 18:
            break
        kept += " " + word
    return kept if len(kept) <= 18 else kept[:17].rstrip() + "…"


# Launchable entries in the developer-mode app list that are plumbing, not
# something anyone wants a tile for. The list is ~500 entries of which a few
# dozen launch; these are the ones that launch and still are not apps. Matched
# on the part of the app id after the package, exactly: a word match would
# also drop a real sideloaded app that happened to be called "Privacy
# Browser". Background services need no entry -- the REST probe already
# turns them away -- except for the odd one that answers it anyway, which the
# id suffix below catches ("TestBGService", "ContinueWatchingService").
SDB_NOISE_IDS = {
    "ADPlayer", "PromotionApp", "PrivacyChoices", "emanual",
    "CastSettingsApp", "RDSGO", "cmsWebApp", "WebAccountExtension",
    "SmartTV",
}
SDB_SERVICE_ID = re.compile(r"(?:BG)?Service$")


def sdb_noise(app_id):
    suffix = app_id.split(".", 1)[-1]
    return suffix in SDB_NOISE_IDS or bool(SDB_SERVICE_ID.search(suffix))


def sdb_app_ids(timeout=5):
    """Every app installed on the TV, as (name, appId), via developer mode.

    The remote channel cannot list apps, but a TV in developer mode runs
    sdbd -- Tizen's fork of adbd -- and `0 applist` there prints the whole
    install, sideloaded apps included. The wire protocol is adb's: 24-byte
    headers, CNXN to say hello, OPEN a shell service, then WRTE/OKAY until
    CLSE. Returns [] when developer mode is off or anything goes wrong, so a
    scan simply falls back to the catalog.
    """
    def packet(cmd, arg0, arg1, data=b""):
        c = struct.unpack("<I", cmd)[0]
        return struct.pack("<6I", c, arg0, arg1, len(data),
                           sum(data) & 0xFFFFFFFF, c ^ 0xFFFFFFFF) + data

    max_data = 256 * 1024          # what CNXN below tells the TV we accept
    # The whole exchange is bounded, not just each recv: empty WRTEs, stray
    # OKAYs or a byte-at-a-time trickle never grow `out`, and would
    # otherwise keep a scan "scanning" forever.
    deadline = time.monotonic() + timeout * 4

    def read(sock, n):
        buf = bytearray()
        while len(buf) < n:
            left = deadline - time.monotonic()
            if left <= 0:
                raise TimeoutError("sdb took too long")
            sock.settimeout(min(left, timeout))
            chunk = sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("sdb closed")
            buf += chunk
        return bytes(buf)

    def message(sock):
        cmd, arg0, _, n, _, _ = struct.unpack("<6I", read(sock, 24))
        if n > max_data:
            raise ConnectionError("sdb payload too large")
        return struct.pack("<I", cmd), arg0, read(sock, n) if n else b""

    out = bytearray()
    try:
        with socket.create_connection((HOST, SDB_PORT), timeout) as sock:
            sock.sendall(packet(b"CNXN", 0x02000000, max_data, b"host::\0"))
            if message(sock)[0] != b"CNXN":
                return []
            sock.sendall(packet(b"OPEN", 1, 0, b"shell:0 applist\0"))
            for _ in range(4096):      # a real list is a handful of packets
                if len(out) >= MAX_HTTP:
                    break
                cmd, remote, data = message(sock)
                if cmd == b"WRTE":
                    out += data
                    sock.sendall(packet(b"OKAY", 1, remote))
                elif cmd == b"CLSE":
                    break
    except Exception:
        if not out:
            return []
    # Rows look like:  'Disney+'	 'MCmYXNxgcu.DisneyPlus'
    rows = re.findall(r"^[ \t]*'([^'\n]{0,200})'[ \t]+'([^'\n]{1,100})'",
                      out[:MAX_HTTP].decode(errors="replace"), re.M)
    # org.tizen.* and com.samsung.* are the firmware's own ~500 components;
    # none of them launch over the REST API, so probing them is wasted time.
    # Anything that is not shaped like an app id is dropped outright -- it is
    # about to go into a URL path -- and the list is capped, because each
    # entry costs a request to the TV.
    found = []
    for name, app_id in rows:
        if (valid_app_id(app_id)
                and not app_id.startswith(("org.tizen.", "com.samsung."))
                and not sdb_noise(app_id)):
            found.append((plain(name), app_id))
            if len(found) >= SDB_MAX_ROWS:
                break
    return found


def scan_apps(timeout=3):
    """Probe every candidate id and return the ones this TV answers to.

    Candidates are the catalog, the config, and -- if the TV is in developer
    mode -- everything it says is installed. Only ids the REST API answers
    for are kept: that is what launching needs, and it drops background
    services from the developer-mode list for free. The probes run in
    parallel because a missing app costs a full timeout and a serial sweep of
    the catalog would take minutes.
    """
    known = {a["appId"]: a for a in load_apps()}
    results = {}
    lock = threading.Lock()

    # Ids the TV gave any HTTP answer for. Only those can be judged "not
    # installed": one that timed out may just be the TV's small HTTP server
    # falling behind, and dropping it would throw away a pinned or
    # hand-added tile along with its name and colour.
    answered = set()

    def probe(app_id, fallback_name):
        if not valid_app_id(app_id):
            return
        try:
            status, raw = http_request(
                "GET", HOST, API_PORT, f"/api/v2/applications/{app_id}",
                timeout=timeout)
        except Exception:
            return
        with lock:
            answered.add(app_id)
        if status != 200:
            return
        try:
            info = json.loads(raw.decode("utf-8", "replace"))
        except Exception:
            return
        if not isinstance(info, dict):
            return
        # The TV's own name can be a mouthful ("Spotify - Music and Podcasts"),
        # so a name already in the config wins -- a scan should not undo the
        # label the user is reading in the panel.
        name = short_name(plain(info.get("name") or fallback_name, 200))
        if app_id in known:
            name = known[app_id]["name"]
        with lock:
            results[app_id] = {
                # New apps get a key once every probe is in; see below.
                "key": known[app_id]["key"] if app_id in known else "",
                "name": name,
                "appId": app_id,
                # A saved colour or mark wins, but not a blank one: apps
                # first scanned before their brand was in the tables would
                # otherwise stay grey and markless for good.
                "color": known[app_id]["color"]
                         if app_id in known
                         and known[app_id]["color"] != FALLBACK_COLOR
                         else default_color(name),
                "glyph": known[app_id]["glyph"]
                         if app_id in known and known[app_id]["glyph"]
                         else default_glyph(name),
                # A newly discovered app stays behind "more" until pinned.
                "show": known[app_id]["show"] if app_id in known else False,
            }

    catalog = dict(CANDIDATE_APPS)
    for app in load_apps():           # never lose a hand-added id to a scan
        catalog.setdefault(app["appId"], app["name"])
    for name, app_id in sdb_app_ids():
        catalog.setdefault(app_id, name)

    # A fixed pool rather than a thread per id, as discover() does: the
    # catalog is bounded, but a thread and a socket each for a few hundred
    # ids would still be a burst the TV's small HTTP server cannot take.
    queue = list(catalog.items())
    qlock = threading.Lock()

    # Each probe is bounded, so this is generous; a straggler past it is
    # abandoned rather than allowed to hold the scan open, and no worker
    # starts a new probe once it has passed.
    deadline = time.monotonic() + (timeout * 3) * (len(queue) // SCAN_WORKERS + 2)

    def worker():
        while time.monotonic() < deadline:
            with qlock:
                if not queue:
                    return
                app_id, name = queue.pop()
            probe(app_id, name)

    threads = [threading.Thread(target=worker, daemon=True)
               for _ in range(min(SCAN_WORKERS, len(queue)))]
    for t in threads:
        t.start()
    for t in threads:
        t.join(max(0, deadline - time.monotonic()))
    with lock:
        done = dict(results)       # stragglers may still be writing
        heard = set(answered)
    if not done:
        # Not one id answered: the TV is off or not listening, which says
        # nothing about what is installed. Leave the config alone.
        raise ConnectionError("the TV did not answer")

    # Configured order first, then anything new the scan turned up.
    ordered = [done[a["appId"]] if a["appId"] in done else a
               for a in load_apps()
               if a["appId"] in done or a["appId"] not in heard]
    seen = {a["appId"] for a in ordered}
    # One app often answers to two ids -- YouTube is both 111299001912 and
    # 9Ur5IzDKqV.TizenYouTube -- so a new id whose name is already present is
    # the same app again, not a second tile.
    names = {a["name"].lower() for a in ordered}
    # Keys are how the panel and `tvctl app` address an app, so two apps must
    # never share one -- "Disney+" and "Disney" both normalise to "disney".
    # Configured keys are reserved as they stand; a new app that collides
    # takes the next free numbered variant.
    used = {a["key"] for a in load_apps()}
    for app_id, app in done.items():
        if app_id in seen or app["name"].lower() in names:
            continue
        if not app["key"]:
            base = (re.sub(r"[^a-z0-9]+", "", app["name"].lower())
                    or re.sub(r"[^a-z0-9]+", "", app_id.lower()))
            key, n = base, 2
            while key in used:
                key, n = f"{base}{n}", n + 1
            app["key"] = key
        used.add(app["key"])
        ordered.append(app)
        names.add(app["name"].lower())
    return ordered


def merge_apps(found):
    """Scan results become the new config, keeping existing keys and colors.

    Pins are re-read here rather than taken from when the scan started: a
    scan takes seconds, and a tile pinned meanwhile must not be undone.
    Call with CONFIG_LOCK held, up to the save.
    """
    pinned = {a["appId"]: a["show"] for a in load_apps()}
    return [dict(a, show=pinned.get(a["appId"], a["show"])) for a in found]


def state_payload(with_volume=True, with_app=True):
    device = read_device()
    payload = {
        "type": "state",
        "reachable": device is not None,
        "paired": bool(load_token()),
        "name": device["name"] if device else "TV",
        "model": device["model"] if device else "",
        "power": device["power"] if device else "off",
        "canWake": bool(load_mac()),
    }
    if with_volume and device is not None:
        volume, muted = read_volume()
        payload["volume"] = -1 if volume is None else volume
        payload["muted"] = bool(muted)
        payload["app"] = foreground_app() if with_app else ""
    else:
        payload["volume"] = -1
        payload["muted"] = False
        payload["app"] = ""
    return payload


# ------------------------------------------------------------------- serve


class Server:
    """Holds one remote-control socket open and feeds stdin keys into it."""

    def __init__(self):
        self.ws = None
        self.lock = threading.Lock()
        # Held across the handshake so two threads cannot each open a socket.
        self.connect_lock = threading.Lock()
        self.reader = None
        self.generation = 0
        # Keys currently held down. A Press with no matching Release leaves
        # the TV ramping forever, so these are released on the way out.
        self.held = set()

    def _drain(self, ws, generation):
        """Own all reads: pings must be answered even while nothing is sent."""
        try:
            while True:
                ws.recv()
        except Exception:
            pass
        with self.lock:
            if self.generation == generation and self.ws is ws:
                self.ws = None
                emit({"type": "disconnected"})
        ws.close()

    def ensure(self):
        """Return the live socket, opening one if needed.

        Double-checked on purpose: the panel warms the connection the moment
        it opens, and a fast first keypress raced it. Both callers saw no
        socket, both connected, and the loser's socket was orphaned and
        closed -- under a held key, that reads to the TV as the remote
        disconnecting, so a hold that should ramp registered a single step.
        """
        with self.lock:
            if self.ws is not None:
                return self.ws
        with self.connect_lock:
            with self.lock:
                if self.ws is not None:
                    return self.ws
            # No token means the TV is about to put an Allow/Deny prompt on
            # screen and then say nothing at all until someone walks over and
            # answers it. The panel has to know that wait has started: the
            # prompt lives exactly as long as the connection that raised it,
            # so a panel that quits this child on losing focus dismisses the
            # very prompt it asked for.
            prompting = not load_token()
            if prompting:
                emit({"type": "pairing"})
            ws, newly_paired = connect(on_prompt=(
                lambda: emit({"type": "pairing", "sent": True}))
                if prompting else None)
            with self.lock:
                self.generation += 1
                self.ws = ws
                generation = self.generation
            self.reader = threading.Thread(
                target=self._drain, args=(ws, generation), daemon=True)
            self.reader.start()
            emit({"type": "connected", "paired_now": newly_paired})
            if prompting:
                # The panel's `paired` comes only from a state poll, and that
                # poll is switched off while the popup is open -- so without
                # this the "Look at your TV" screen outlived the pairing it
                # was waiting for, and answering the prompt looked ignored.
                threading.Thread(
                    target=lambda: emit(state_payload()), daemon=True).start()
            return ws

    def key(self, name, cmd="Click"):
        """Send a key, retrying once: an idle socket may have been dropped."""
        for attempt in (0, 1):
            ws = None
            try:
                ws = self.ensure()
                send_key(ws, name, cmd)
                if cmd == "Press":
                    self.held.add(name)
                    HELD_KEYS.add(name)
                elif cmd == "Release":
                    self.held.discard(name)
                    HELD_KEYS.discard(name)
                return True
            except Exception as exc:
                # Only retire the socket that actually failed. A wake runs
                # server.key() from its own thread while the stdin loop may
                # have already reconnected, and closing whatever happens to
                # be current would tear down a healthy new connection --
                # the same identity check _drain() already makes.
                stale = None
                with self.lock:
                    if ws is not None and self.ws is ws:
                        stale = ws
                        self.ws = None
                        self.generation += 1
                if stale is not None:
                    stale.close()
                if attempt:
                    emit({"type": "error", "key": name,
                          "msg": f"{type(exc).__name__}: {plain(exc, 200)}"})
                    return False
        return False

    def close(self):
        # Let go of anything still held before dropping the socket, or the TV
        # carries on repeating after the panel has gone.
        for name in list(self.held):
            try:
                send_key(self.ws, name, "Release")
            except Exception:
                pass
        self.held.clear()
        HELD_KEYS.clear()
        with self.lock:
            ws, self.ws = self.ws, None
            self.generation += 1
        if ws is not None:
            ws.close()


def _warm(server):
    """Open the socket before any key is pressed.

    On a first run this is also what triggers pairing, so a failure here is
    reported as a pairing hint rather than a bare exception.

    The panel starts this child when its popup opens, so the handshake
    overlaps with the user reaching for a button instead of delaying the
    first press -- and the panel can say "connected" truthfully.
    """
    try:
        server.ensure()
    except Exception as exc:
        if not load_token():
            emit({"type": "error",
                  "msg": "Accept the connection prompt on the TV, then reopen"})
        else:
            emit({"type": "error", "msg": f"{type(exc).__name__}: {plain(exc, 200)}"})


def dispatch(cmd, server, held_since, pressed_at):
    """Handle one stdin command. Returns True, or "quit" to stop.

    Split out of serve() so the loop can wrap it: this daemon parses
    replies from a closed appliance and from whatever else answers on
    the LAN, and one unforeseen shape should degrade to an error line
    rather than kill a widget the user is mid-keypress on.
    """
    if cmd == "quit":
        return "quit"
    if cmd == "state":
        threading.Thread(
            target=lambda: emit(state_payload()), daemon=True).start()
        return True
    if cmd.startswith("pick:"):
        ip = cmd[5:]
        if not valid_ipv4(ip):
            emit({"type": "error", "msg": f"not an address: {plain(ip)}"})
            return True
        # Off the stdin loop: identifying the TV is a network round trip,
        # and keys typed meanwhile should not queue up behind it.
        threading.Thread(target=_pick_and_report, args=(ip, server),
                         daemon=True).start()
        return True
    if cmd == "rediscover":
        threading.Thread(target=_rediscover, daemon=True).start()
        return True
    if cmd == "reconnect":
        threading.Thread(target=_warm, args=(server,), daemon=True).start()
        return True
    if cmd == "wake" or cmd.startswith("wake:"):
        # "wake:youtube" means the user clicked an app while the TV
        # was off: turn it on, then open that app rather than
        # whatever happened to be on screen last.
        target = cmd[5:] if cmd.startswith("wake:") else ""
        if target and app_by_key(target) is None:
            emit({"type": "error", "msg": f"unknown app: {plain(target)}"})
            return True
        threading.Thread(target=_wake_and_watch,
                         args=(server, target), daemon=True).start()
        return True
    if cmd == "apps":
        emit({"type": "apps", "apps": load_apps()})
        return True
    if cmd.startswith("pin:"):
        if toggle_pin(cmd[4:]):
            emit({"type": "apps", "apps": load_apps()})
        else:
            emit({"type": "error", "msg": f"unknown app: {plain(cmd[4:])}"})
        return True
    if cmd == "scan":
        threading.Thread(target=_scan_and_report, daemon=True).start()
        return True
    if cmd.startswith("press:") or cmd.startswith("release:"):
        verb, _, name = cmd.partition(":")
        if name not in KEYS:
            emit({"type": "error", "msg": f"unknown key: {plain(name)}"})
            return True
        now = time.monotonic()
        if verb == "press":
            # Stamped before the send, which can block: the very first
            # press waits on the opening handshake, and without this
            # the release that follows would cut a real one-second
            # hold down to the few milliseconds left after connecting.
            held_since[name] = now
            if server.key(name, "Press"):
                pressed_at[name] = time.monotonic()
                emit({"type": "ack", "key": cmd})
        else:
            intended = now - held_since.pop(name, now)
            already = now - pressed_at.pop(name, now)
            shortfall = intended - already
            if shortfall > 0.05:
                time.sleep(min(shortfall, 5.0))
            if server.key(name, "Release"):
                emit({"type": "ack", "key": cmd})
                if name in VOLUME_KEYS:
                    threading.Thread(target=_volume_after,
                                     args=(name,), daemon=True).start()
        return True
    if cmd.startswith("app:"):
        key = cmd[4:]
        if app_by_key(key) is None:
            emit({"type": "error", "msg": f"unknown app: {plain(key)}"})
        else:
            threading.Thread(target=_launch_and_report,
                             args=(key,), daemon=True).start()
        return True
    if cmd not in KEYS:
        emit({"type": "error", "msg": f"unknown key: {plain(cmd)}"})
        return True
    if server.key(cmd):
        emit({"type": "ack", "key": cmd})
        if cmd in VOLUME_KEYS:
            # The remote channel never reports the resulting volume;
            # give the TV a moment to apply the key, then read it.
            threading.Thread(target=_volume_after,
                             args=(cmd,), daemon=True).start()


def serve():
    if not HOST:
        # Either nothing was found, or several were and the choice is the
        # user's to make. Both are reported the same way; the panel shows a
        # picker when the list is non-empty.
        emit({"type": "tvs", "tvs": DISCOVERED})
        emit({"type": "state", "reachable": False, "paired": bool(load_token()),
              "name": "Choose a TV" if DISCOVERED else "No TV found",
              "model": "", "power": "off", "canWake": False,
              "volume": -1, "muted": False, "app": ""})
    server = Server()
    # When each key was asked for, and when its Press actually went out.
    held_since = {}
    pressed_at = {}
    # Report reachability immediately: the panel opens on this, and a TV that
    # is off should say so rather than look like a hung connection.
    emit({"type": "apps", "apps": load_apps()})
    # The opening poll deliberately skips the app probe. It is a burst of
    # requests this TV's HTTP server answers slowly, and it lands exactly when
    # someone who just opened the panel is holding a volume button -- which
    # starves the TV's key repeat down to a single step. The foreground app is
    # worth knowing, but not at the cost of the first hold.
    threading.Thread(target=lambda: emit(state_payload(with_app=False)),
                     daemon=True).start()
    threading.Thread(target=_warm, args=(server,), daemon=True).start()
    threading.Thread(target=_deferred_app, daemon=True).start()
    try:
        # readline(), not `for line in sys.stdin`: the iterator reads ahead in
        # chunks, so a press and the release that follows it a second later
        # arrived together and every hold collapsed into a single tap.
        while True:
            line = sys.stdin.readline()
            if not line:
                break
            cmd = line.strip().lower()
            if not cmd:
                continue
            try:
                handled = dispatch(cmd, server, held_since, pressed_at)
            except Exception as exc:
                # This daemon parses replies from an appliance and from
                # whatever else answers on the LAN. One unforeseen shape
                # should degrade to an error line, never kill the widget.
                emit({"type": "error", "msg": f"{type(exc).__name__}: {plain(exc, 200)}"})
                continue
            if handled == "quit":
                break
            if handled:
                continue
    except (KeyboardInterrupt, BrokenPipeError):
        pass
    finally:
        server.close()


def toggle_pin(key):
    with CONFIG_LOCK:
        apps = load_apps()
        hit = False
        for a in apps:
            if a["key"] == key:
                a["show"] = not a["show"]
                hit = True
        if hit:
            save_apps(apps)
    return hit


def _deferred_app():
    """Report the foreground app once the panel has settled, not on open."""
    time.sleep(1.5)
    for _ in range(20):          # never probe over someone's held button
        if not HELD_KEYS:
            break
        time.sleep(0.5)
    app = foreground_app()
    if app:
        emit({"type": "app", "app": app})


def _pick_and_report(ip, server):
    try:
        info = choose_host(ip)
    except Exception as exc:
        emit({"type": "error", "msg": f"{type(exc).__name__}: {plain(exc, 200)}"})
        return
    emit({"type": "picked", "ip": ip,
          "name": info["name"] if info else ip})
    emit({"type": "apps", "apps": load_apps()})
    threading.Thread(
        target=lambda: emit(state_payload()), daemon=True).start()
    _warm(server)


def _rediscover():
    global DISCOVERED
    DISCOVERED = discover()
    emit({"type": "tvs", "tvs": DISCOVERED})


def _wake_and_watch(server, target=""):
    """Full power-on, reporting each stage so the panel can say where it is.

    Finishes by opening an app: the one asked for, or failing that whatever
    was last on screen. A TV woken from the network lands on the home
    screen, which is never where you left off.
    """
    def progress(stage):
        emit({"type": "waking", "stage": stage})
        if stage == "network":
            emit(state_payload(with_app=False))

    try:
        ok = power_on(lambda: server.key("power"), on_progress=progress)
    except Exception as exc:
        emit({"type": "error", "msg": f"wake: {plain(exc, 200)}"})
        return
    if not ok:
        # Almost always one specific TV setting rather than a bug, so say
        # which one instead of reporting a bare failure.
        emit({"type": "wakefailed",
              "reachable": read_device(timeout=2) is not None})
        emit(state_payload(with_app=False))
        return

    # An explicitly asked-for app always wins over the remembered one, and is
    # opened even when resuming is switched off -- the user just clicked it.
    wanted = target or (load_last_app() if RESUME_APP else "")
    if wanted and app_by_key(wanted):
        emit({"type": "waking", "stage": "resume", "app": wanted})
        for attempt in range(3):
            time.sleep(3)                 # the TV refuses launches while booting
            try:
                launch_app(wanted)
                break
            except Exception:
                if attempt == 2:
                    emit({"type": "error", "msg": f"could not open {wanted}"})
        time.sleep(2)
    emit(state_payload())


# One scan at a time: two would race to rewrite the same config.
SCAN_LOCK = threading.Lock()
# Every read-modify-write of the app config, so a pin and a scan's save
# cannot interleave.
CONFIG_LOCK = threading.Lock()


def _scan_and_report():
    if not SCAN_LOCK.acquire(blocking=False):
        return                       # the running scan will report
    try:
        emit({"type": "scanning"})
        try:
            found = scan_apps()
            with CONFIG_LOCK:
                save_apps(merge_apps(found))
        except Exception as exc:
            emit({"type": "error", "msg": f"scan: {type(exc).__name__}"})
            return
        emit({"type": "apps", "apps": load_apps(), "scanned": True})
    finally:
        SCAN_LOCK.release()


def _launch_and_report(key):
    try:
        launch_app(key)
    except Exception as exc:
        emit({"type": "error", "msg": f"{key}: {type(exc).__name__}"})
        return
    emit({"type": "ack", "key": "app:" + key})
    # The TV reports `visible` only once the app has actually come up.
    time.sleep(1.2)
    emit({"type": "app", "app": foreground_app()})


def _volume_after(_cmd):
    """Report the new volume, twice.

    The TV applies a volume key on its own schedule and will happily answer
    the UPnP query with the old number if asked too soon, so this reads once
    quickly for responsiveness and once again to correct itself.
    """
    last = None
    for delay in (0.35, 1.0):
        time.sleep(delay if last is None else delay - 0.35)
        if HELD_KEYS:
            continue  # still ramping; the release read will be the real one
        volume, muted = read_volume()
        if volume is None or volume == last:
            continue
        last = volume
        emit({"type": "volume", "volume": volume, "muted": bool(muted)})


# --------------------------------------------------------------------- CLI


def main(argv):
    if argv and argv[0] not in ("-h", "--help", "discover", "pick", "unpair"):
        ensure_host()
        # `serve` is the one command that is useful without a TV: it is what
        # presents the picker when several were found, and the "no TV found"
        # state when none were. Bailing here left first-launch users on a
        # network with two TVs staring at a widget whose backend had exited.
        if not HOST and argv[0] != "serve":
            print("no TV found; run `tvctl discover` or set TV_HOST",
                  file=sys.stderr)
            return 1
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip().splitlines()[0])
        print("usage: tvctl serve | discover | state | apps | scan [--save]"
              " | app <name> | wake | hold <key> [secs] | unpair [--all]"
              " | <key>...")
        print("keys:  " + " ".join(sorted(KEYS)))
        print("apps:  " + " ".join(a["key"] for a in load_apps()))
        return 0
    if argv[0] == "serve":
        serve()
        return 0
    if argv[0] == "state":
        emit(state_payload())
        return 0
    if argv[0] == "unpair":
        # Only ever half the job: the TV keeps its own allow-list keyed by
        # client name, and reconnecting under a name it still trusts is
        # re-authorised silently. Say so rather than implying it is done.
        removed = []
        targets = [("token", TOKEN_FILE)]
        if "--all" in argv:
            targets += [("host", HOST_FILE), ("mac", MAC_FILE),
                        ("last app", LAST_APP_FILE), ("apps", APPS_FILE)]
        for label, path in targets:
            try:
                os.remove(path)
                removed.append(label)
            except OSError:
                pass
        print("cleared locally: " + (", ".join(removed) if removed else "nothing"))
        print()
        print(f"The TV still trusts this client by name ({CLIENT_NAME!r}).")
        print("To make it ask again, remove that entry on the TV:")
        print("  Settings -> General -> External Device Manager")
        print("            -> Device Connect Manager -> Device List")
        print("(exact wording varies by model year)")
        print()
        print(f"Or connect under a name it has not seen: "
              f"TV_NAME='{CLIENT_NAME}-2' {sys.argv[0]} state")
        return 0
    if argv[0] == "pick":
        if len(argv) < 2 or not valid_ipv4(argv[1]):
            print("usage: tvctl pick <ip>", file=sys.stderr)
            return 2
        info = choose_host(argv[1])
        print(f"using {argv[1]}" + (f" ({info['name']})" if info else
                                    " (not answering right now)"))
        return 0
    if argv[0] == "discover":
        found = discover()
        if not found:
            print("no Samsung TV found on this network", file=sys.stderr)
            return 1
        for d in found:
            mac = ":".join(d["mac"][i:i + 2] for i in range(0, 12, 2))
            print(f"{d['ip']:15s}  {d['name']}  ({d['model']})")
            print(f"                 mac={mac or 'unknown'}  "
                  f"token-auth={'yes' if d['tokenAuth'] else 'no'}  "
                  f"remote={'yes' if d['remote'] else 'no'}")
        return 0
    if argv[0] == "wake":
        def send_power():
            ws, _ = connect()
            try:
                send_key(ws, "power")
                time.sleep(0.25)
                return True
            finally:
                ws.close()

        stages = {"packet": "magic packet sent",
                  "network": "network stack up (standby)",
                  "power": "power key sent"}
        ok = power_on(send_power, on_progress=lambda st: print(stages.get(st, st)))
        print("TV is on" if ok else "TV did not come on")
        return 0 if ok else 1
    if argv[0] == "hold":
        # tvctl hold voldown 1.5 -- the CLI equivalent of holding the button.
        if len(argv) < 2 or argv[1].lower() not in KEYS:
            print("usage: tvctl hold <key> [seconds]", file=sys.stderr)
            return 2
        name = argv[1].lower()
        seconds = float(argv[2]) if len(argv) > 2 else 1.0
        ws, _ = connect()
        try:
            send_key(ws, name, "Press")
            time.sleep(seconds)
            send_key(ws, name, "Release")
            time.sleep(0.25)
        finally:
            ws.close()
        return 0
    if argv[0] == "apps":
        # Re-checks each id against the TV; the way to find ids for another set.
        for app in load_apps():
            info = app_status(app["appId"])
            if info is None:
                print(f"{app['key']:<9} {app['appId']:<15} {app['name']}  NOT INSTALLED")
            else:
                print(f"{app['key']:<9} {app['appId']:<15} {plain(info.get('name') or '')}"
                      f"  running={info.get('running') is True}"
                      f" visible={info.get('visible') is True}")
        print(f"\nconfig: {APPS_FILE}")
        return 0
    if argv[0] == "scan":
        found = scan_apps()
        for app in found:
            print(f"{app['key']:<12} {app['appId']:<15} {app['name']}")
        if "--save" in argv:
            merged = merge_apps(found)
            save_apps(merged)
            print(f"\nsaved {len(merged)} apps to {APPS_FILE}")
        else:
            print(f"\n{len(found)} installed; re-run with --save to write {APPS_FILE}")
        return 0
    if argv[0] == "app":
        if len(argv) < 2 or app_by_key(argv[1].lower()) is None:
            print("usage: tvctl app "
                  + "|".join(a["key"] for a in load_apps()), file=sys.stderr)
            return 2
        launch_app(argv[1].lower())
        return 0

    unknown = [a for a in argv if a.lower() not in KEYS]
    if unknown:
        print("unknown key(s): " + " ".join(unknown), file=sys.stderr)
        return 2
    ws, newly_paired = connect()
    if newly_paired:
        print("paired with the TV; token saved", file=sys.stderr)
    try:
        for i, name in enumerate(argv):
            if i:
                time.sleep(0.15)
            send_key(ws, name.lower())
        time.sleep(0.25)  # let the last frame flush before the socket drops
    finally:
        ws.close()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:
        print(f"error: {type(exc).__name__}: {plain(exc, 200)}", file=sys.stderr)
        sys.exit(1)
